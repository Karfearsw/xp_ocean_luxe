{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/cron/process-crm-sync",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/release-availability-holds",
      "schedule": "0 * * * *"
    }
  ]
}
