# XP Ocean Luxe Booking App — environment template
# Copy to `.env` for local development and fill in real values.
# Values below are PLACEHOLDERS only — never commit real secrets.

# ---------- Required ----------

# Neon Postgres connection string (one of these is enough; priority is left-to-right)
DATABASE_URL=postgresql://user:password@host:5432/dbname
# POSTGRES_URL=postgresql://user:password@host:5432/dbname
# NEON_DATABASE_URL=postgresql://user:password@host:5432/dbname

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Resend (transactional email)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=bookings@example.com

# Existing CRM (opportunity sync) — do not create a second CRM app here
CRM_API_BASE_URL=https://crm.oceanluxe.org
CRM_API_TOKEN=your_crm_api_token

# Discord webhook for secondary verification notifications
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# ---------- Sessions / admin auth ----------

# Admin API token for admin endpoints
ADMIN_API_TOKEN=your_admin_api_token
# Admin session password (admin login page)
ADMIN_PASSWORD=your_admin_password
# Session signing secret (random string)
SESSION_SECRET=your_random_session_secret
# Email that receives admin alerts (optional)
ADMIN_ALERT_EMAIL=admin@example.com

# ---------- Public origin ----------

# Canonical public URL of this app (pick one; falls back to VERCEL_URL when unset)
PUBLIC_SITE_URL=https://your-deployment.vercel.app
# SITE_URL=https://your-deployment.vercel.app
# PUBLIC_APP_URL=https://your-deployment.vercel.app

# ---------- Optional behavior flags ----------

# Allow the app to run without a database (uses sample data) — "true" or unset
ALLOW_OFFLINE_MODE=false
# Run SQL migrations automatically on boot — "true" or unset
AUTO_APPLY_MIGRATIONS=false
# Minutes before an unconfirmed availability hold is released
AVAILABILITY_HOLD_TTL_MINUTES=15

# NODE_ENV is set by the runtime; VERCEL_ENV / VERCEL_URL are set by Vercel.
